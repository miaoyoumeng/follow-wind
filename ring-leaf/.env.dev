VITE_GLOB_APP_TITLE = 珠海
VITE_GLOB_APP_PREFIX = ZhuHai
VITE_GLOB_APP_ID = 254
# 本地环境
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = hash

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = false

# 开发环境接口地址
VITE_API_URL = /api

# 本地运行端口号
VITE_PORT = 8800

# 开发环境跨域代理，支持配置多个
# VITE_PROXY = [["/api","https://m1.apifoxmock.com/m1/8520177-8294671-default"]]
