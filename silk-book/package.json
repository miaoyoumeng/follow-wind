{
  "name": "silk-book",
  "version": "1.0.0",
  "description": "Silk Book Desktop App",
  "main": "dist/app/index.js",
  "bin": {
    "silkbook": "./dist/cli/index.js"
  },
  "author": {
    "name": "miaoyoumeng",
    "email": "miaoyoumeng@gmail.com"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "type": "module",
  "scripts": {
    "app": "tsc -p tsconfig.app.json && electron .",
    "app-all": "pnpm run build && electron .",
    "build": "vue-tsc --noEmit  && vite build && tsc -p tsconfig.app.json && tsc -p tsconfig.preload.json",
    "clean": "rm -rf node_modules pnpm-*.yaml package-*.json dist ",
    "serve": "vite --mode dev",
    "lint:eslint": "eslint . --ext .ts,.tsx,.vue --fix",
    "lint:format": "prettier --write \"src/**/*.{js,ts,json,css,scss,vue}\"",
    "lint:prettier": "prettier --check \"src/**/*.{js,ts,json,css,scss,vue}\"",
    "package": "pnpm run build && electron-builder",
    "type": "vue-tsc --noEmit && tsc -p tsconfig.app.json",
    "test": "vitest"
  },
  "build": {
    "appId": "silk-book",
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "/tmp/${version}"
    },
    "files": [
      "dist"
    ],
    "mac": {
      "artifactName": "${productName}_${version}.${ext}",
      "target": [
        "dmg"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.6.3",
    "ajv-formats": "^2.1.1",
    "atomically": "^1.7.0",
    "axios": "^1.13.6",
    "chalk": "^5.6.2",
    "cherry-markdown": "^0.10.3",
    "commander": "^14.0.3",
    "conf": "^10.2.0",
    "debounce-fn": "^4.0.0",
    "dot-prop": "^6.0.1",
    "electron-store": "^8.1.0",
    "env-paths": "^2.2.1",
    "fast-deep-equal": "^3.1.3",
    "fast-uri": "^3.0.1",
    "find-up": "^3.0.0",
    "is-obj": "^2.0.0",
    "json-schema-traverse": "^1.0.0",
    "json-schema-typed": "^7.0.3",
    "locate-path": "^3.0.0",
    "md5": "^2.3.0",
    "mimic-fn": "^3.0.0",
    "onetime": "^5.1.2",
    "p-limit": "^2.0.0",
    "p-locate": "^3.0.0",
    "p-try": "^2.0.0",
    "path-exists": "^3.0.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pkg-up": "^3.1.0",
    "require-from-string": "^2.0.2",
    "semver": "^7.3.5",
    "tdesign-icons-vue-next": "^0.4.2",
    "tdesign-vue-next": "^1.18.5",
    "type-fest": "^2.17.0",
    "vite-plugin-html": "^3.2.2",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/runtime-core": "^3.5.30",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^36.3.2",
    "electron-builder": "^24.6.3",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^4.1.2",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5"
  }
}
